# Database
DATABASE_URL="postgresql://user:password@localhost:5432/encave?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/encave?schema=public"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers (optional) — Apple removed in P-14 (D5)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
# Svix signing secret of the Resend webhook (open/click tracking, P-07)
RESEND_WEBHOOK_SECRET=""
# Internal escalation inbox (P-10): unanswered sur-mesure requests > 48h
ADMIN_ALERT_EMAIL=""
# Reply-To of every outgoing email (the sender noreply@encave.ch has no
# inbox). MUST be a monitored mailbox. Default: support@encave.ch
EMAIL_REPLY_TO="support@encave.ch"

# Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Rate Limiting (Upstash Redis) - optional, falls back to in-memory
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."
PLATFORM_COMMISSION_RATE=0.12

# Cron Jobs — MANDATORY on every Vercel environment: crons authenticate
# with `Authorization: Bearer $CRON_SECRET` only (unset = every cron is 401).
CRON_SECRET="your-cron-secret-min-32-characters-long"

# Launch gate (P-16 / WS-I): anything but "false" keeps encave.ch on the
# Coming Soon page. Flip to "false" at launch (Vercel env + redeploy).
COMING_SOON="true"

# Write freeze (docs/runbooks/restauration-db.md): "true" serves the
# maintenance page on every page request and answers 503 + Retry-After on
# mutating API calls and server actions — /api/webhooks/**, /api/cron/** and
# /api/health keep answering. Vercel env + redeploy, like COMING_SOON.
# Leave empty/unset in normal operation.
MAINTENANCE_MODE=""

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Analytics (Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# Next.js / Site — canonical URLs, hreflang, sitemap and robots.txt. In
# production BOTH must be https://encave.ch (or unset: that is the fallback).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# E2E simulation switch (Playwright / k6 only): fake Stripe sessions, rate
# limits off. NEVER set on Vercel — the app refuses to boot with it when
# VERCEL_ENV=production. Leave unset.
# E2E_TEST="true"
