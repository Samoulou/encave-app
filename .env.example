# EnCave Environment Variables
# Copy this file to .env.local for local development

# ===========================================
# Database
# ===========================================
# PostgreSQL connection string (Neon recommended for production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/encave?schema=public"

# ===========================================
# Authentication (NextAuth.js v5 / Auth.js)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-character-minimum-secret-here"

# Application URL (set to your deployment URL in production)
AUTH_URL="http://localhost:3000"

# Google OAuth (optional for MVP)
# GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="xxx"

# ===========================================
# Stripe (Phase 2+)
# ===========================================
# STRIPE_SECRET_KEY="sk_test_xxx"
# STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ===========================================
# Email (Phase 2+)
# ===========================================
# RESEND_API_KEY="re_xxx"

# ===========================================
# Storage (Phase 2+)
# ===========================================
# BLOB_READ_WRITE_TOKEN="vercel_blob_xxx"
