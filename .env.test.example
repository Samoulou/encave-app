# E2E test environment — copy to .env.test (gitignored).
# NONE of these values are real secrets: Stripe never gets called in e2e
# (E2E_TEST fake-session convention) and the webhook secret only needs to
# be IDENTICAL on both sides of the signed synthetic events
# (tests/e2e/utils/stripe-webhook.ts). CI generates .env.test from this
# file verbatim — keep it working as-is against docker-compose.test.yml.

# Docker test database (npm run test:db:start → localhost:5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/encave_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/encave_test"

# Auth — arbitrary 32+ char string, prod requires one
BETTER_AUTH_SECRET="e2e-test-secret-not-a-real-secret-0123456789"
BETTER_AUTH_URL="http://localhost:3000"

# Stripe — placeholders with the right prefixes for the Zod env schema.
# sk_/pk_ are never used against the API; whsec_ signs the synthetic
# webhooks (shared by the test runner and the webServer).
STRIPE_SECRET_KEY="sk_test_e2e_placeholder_never_called"
STRIPE_PUBLISHABLE_KEY="pk_test_e2e_placeholder_never_called"
STRIPE_WEBHOOK_SECRET="whsec_e2e_placeholder_0123456789abcdef"
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_e2e_connect_0123456789abcdef"

# Base URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
