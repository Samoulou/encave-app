// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  WINEMAKER
  ADMIN
}

enum WineryStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ExperienceType {
  TASTING
  CELLAR_VISIT
  WORKSHOP
  VINEYARD_TOUR
  FOOD_PAIRING
}

enum ExperienceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_WINERY
  COMPLETED
  NO_SHOW
}

enum Locale {
  FR
  DE
  EN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  passwordHash    String?
  image           String?
  role            UserRole  @default(CLIENT)
  preferredLocale Locale    @default(FR)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  winery   Winery?

  @@map("users")
}

model Winery {
  id                       String       @id @default(cuid())
  name                     String       @unique
  slug                     String       @unique
  description              String
  address                  String
  commune                  String
  phone                    String
  email                    String
  coverPhoto               String?
  userId                   String       @unique
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                   WineryStatus @default(PENDING)
  verifiedAt               DateTime?
  verifiedBy               String?
  rejectionReason          String?
  stripeAccountId          String?      @unique
  stripeOnboardingComplete Boolean      @default(false)
  stripeDetailsSubmitted   Boolean      @default(false)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  galleryImages    WineryGalleryImage[]
  verificationLogs VerificationLog[]
  experiences      Experience[]
  bookings         Booking[]

  @@index([commune])
  @@index([status])
  @@map("wineries")
}

model WineryGalleryImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  wineryId  String
  winery    Winery   @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("winery_gallery_images")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model VerificationLog {
  id        String   @id @default(cuid())
  wineryId  String
  winery    Winery   @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  action    String   // 'APPROVED' | 'REJECTED'
  adminId   String
  reason    String?
  createdAt DateTime @default(now())

  @@map("verification_logs")
}

model Experience {
  id          String           @id @default(cuid())
  wineryId    String
  winery      Winery           @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String           @db.Text
  type        ExperienceType
  duration    Int              // minutes
  price       Int              // cents (CHF)
  minCapacity Int
  maxCapacity Int
  coverPhoto  String
  status      ExperienceStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  galleryImages     ExperienceGalleryImage[]
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]

  @@unique([wineryId, slug])
  @@index([status])
  @@index([type])
  @@index([price])
  @@index([status, type])
  @@index([status, price])
  @@index([createdAt])
  @@map("experiences")
}

model ExperienceGalleryImage {
  id           String     @id @default(cuid())
  url          String
  order        Int        @default(0)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@map("experience_gallery_images")
}

model AvailabilitySlot {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        // 0 = Sunday, 6 = Saturday
  startTime    String     // "HH:mm" format
  endTime      String     // "HH:mm" format
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([experienceId, dayOfWeek])
  @@index([experienceId, isActive])
  @@map("availability_slots")
}

model Booking {
  id                    String        @id @default(cuid())
  reference             String        @unique // ENC-XXXXXX
  visitorEmail          String
  visitorName           String
  visitorPhone          String
  experienceId          String
  experience            Experience    @relation(fields: [experienceId], references: [id])
  wineryId              String
  winery                Winery        @relation(fields: [wineryId], references: [id])
  date                  DateTime      @db.Date
  timeSlot              String        // "HH:mm"
  guestCount            Int
  totalPrice            Int           // cents
  platformFee           Int           // cents
  wineryPayout          Int           // cents
  status                BookingStatus @default(PENDING_PAYMENT)
  stripePaymentIntentId String?
  expiresAt             DateTime?     // For pending payment reservations
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([experienceId, date, timeSlot])
  @@index([wineryId, date])
  @@index([status])
  @@index([reference])
  @@map("bookings")
}
