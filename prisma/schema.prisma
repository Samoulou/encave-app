// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // P-06 (L-207): pg_trgm feeds the GIN indexes behind the ILIKE search
  // (catalogue) and the case-insensitive visitorEmail lookups.
  extensions = [pg_trgm]
}

enum UserRole {
  CLIENT
  WINEMAKER
  ADMIN
}

enum WineryStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ExperienceType {
  TASTING
  CELLAR_VISIT
  WORKSHOP
  VINEYARD_TOUR
  FOOD_PAIRING
  MEAL
  EVENT
}

enum CancellationPolicy {
  FLEXIBLE
  STANDARD
  STRICT
}

enum WineryPlan {
  FOUNDER
  STANDARD
}

enum GiftCardStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum GiftCardTransactionType {
  PURCHASE
  REDEMPTION
  REFUND
  ADJUSTMENT
}

enum RequestStatus {
  PENDING
  OFFERED
  PAID
  EXPIRED
  CLOSED
}

enum RequestOfferStatus {
  SENT
  PAID
  EXPIRED
  WITHDRAWN
}

enum OccurrenceStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ScheduledJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  CANCELLED
}

enum ExperienceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_WINERY
  COMPLETED
  NO_SHOW
}

enum Locale {
  FR
  DE
  EN
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    Boolean   @default(false)
  name             String?
  image            String?
  cookieConsent    Json?
  anonymizedAt     DateTime?
  suspendedAt      DateTime?
  suspendedBy      String?
  suspensionReason String?
  // Custom fields (not part of Better Auth core schema)
  role             UserRole  @default(CLIENT)
  preferredLocale  Locale    @default(FR)
  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  winery   Winery?

  @@index([suspendedAt])
  @@map("users")
}

model Winery {
  id                       String             @id @default(cuid())
  name                     String             @unique
  slug                     String             @unique
  description              String
  address                  String
  commune                  String
  phone                    String
  email                    String
  coverPhoto               String?
  latitude                 Float? // Geocoded from address
  longitude                Float? // Geocoded from address
  userId                   String             @unique
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                   WineryStatus       @default(PENDING)
  verifiedAt               DateTime?
  verifiedBy               String?
  rejectionReason          String?
  stripeAccountId          String?            @unique
  stripeOnboardingComplete Boolean            @default(false)
  stripeDetailsSubmitted   Boolean            @default(false)
  // P-13 / email #18 anti-spam: account.updated is chatty — the KYC
  // "action required" email is resent only when the currently_due set
  // changed (hash) or after 7 days.
  stripeActionEmailAt      DateTime?
  stripeActionDueHash      String?
  // V3 monetization & policies (P-02 foundations — consumed from P-03 on).
  // commissionRate null = platform default (PLATFORM_COMMISSION_RATE env).
  plan                     WineryPlan         @default(STANDARD)
  commissionRate           Float?
  cancellationPolicy       CancellationPolicy @default(STANDARD)
  noShowFeeEnabled         Boolean            @default(false)
  noShowFeeCents           Int                @default(1500)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  galleryImages           WineryGalleryImage[]
  verificationLogs        VerificationLog[]
  experiences             Experience[]
  bookings                Booking[]
  notificationPreferences NotificationPreferences?
  wines                   Wine[]
  wineOrderRequests       WineOrderRequest[]
  requests                Request[]
  eventParticipations     EventParticipant[]

  @@index([commune])
  @@index([status])
  // P-06 (L-207): trigram GIN for the ILIKE '%…%' catalogue search.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "wineries_name_trgm_idx")
  @@index([commune(ops: raw("gin_trgm_ops"))], type: Gin, map: "wineries_commune_trgm_idx")
  @@map("wineries")
}

model WineryGalleryImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  wineryId  String
  winery    Winery   @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("winery_gallery_images")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  // Better Auth primary fields
  accountId             String // Provider's user ID
  providerId            String // Provider name (e.g., "google", "credential")
  // Password for credential accounts (Better Auth stores password here, not in user table)
  password              String?
  // OAuth tokens
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  // Timestamps
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique // Better Auth session token
  userId    String
  expiresAt DateTime // Better Auth expiration
  ipAddress String? // Better Auth client IP
  userAgent String? // Better Auth user agent
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Better Auth verification table
model Verification {
  id         String   @id @default(cuid())
  identifier String // Email or other identifier
  value      String // Verification code/token
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verifications")
}

model VerificationLog {
  id        String   @id @default(cuid())
  wineryId  String
  winery    Winery   @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  action    String // 'APPROVED' | 'REJECTED'
  adminId   String
  reason    String?
  createdAt DateTime @default(now())

  @@map("verification_logs")
}

model Experience {
  id           String           @id @default(cuid())
  wineryId     String
  winery       Winery           @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  description  String           @db.Text
  type         ExperienceType
  duration     Int // minutes
  price        Int // cents (CHF)
  minCapacity  Int
  maxCapacity  Int
  // V3 (P-02 foundations): spoken languages and collective events (US-250).
  languages    Locale[]         @default([FR])
  isCollective Boolean          @default(false)
  coverPhoto   String
  // Location fields (optional - falls back to winery address if not set)
  address      String? // Street address
  city         String? // City/commune
  zipCode      String? // Postal code
  latitude     Float? // Geocoded latitude
  longitude    Float? // Geocoded longitude
  status       ExperienceStatus @default(DRAFT)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  galleryImages     ExperienceGalleryImage[]
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]
  blockedDates      BlockedDate[]
  occurrences       ExperienceOccurrence[]
  participants      EventParticipant[]
  giftCards         GiftCard[]

  @@unique([wineryId, slug])
  @@index([wineryId])
  @@index([status])
  @@index([type])
  @@index([price])
  @@index([status, type])
  // P-06 (L-207): trigram GIN for the ILIKE '%…%' catalogue search.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "experiences_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "experiences_description_trgm_idx")
  @@index([status, price])
  @@index([createdAt])
  @@map("experiences")
}

model ExperienceGalleryImage {
  id           String     @id @default(cuid())
  url          String
  order        Int        @default(0)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@map("experience_gallery_images")
}

model AvailabilitySlot {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 0 = Sunday, 6 = Saturday
  startTime    String // "HH:mm" format
  endTime      String // "HH:mm" format
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([experienceId, dayOfWeek])
  @@index([experienceId, isActive])
  @@map("availability_slots")
}

model Booking {
  id                      String                @id @default(cuid())
  reference               String                @unique // ENC-XXXXXX
  visitorEmail            String
  visitorName             String
  visitorPhone            String
  experienceId            String
  experience              Experience            @relation(fields: [experienceId], references: [id])
  wineryId                String
  winery                  Winery                @relation(fields: [wineryId], references: [id])
  date                    DateTime              @db.Date
  timeSlot                String // "HH:mm"
  guestCount              Int
  totalPrice              Int // cents — experience price × guests (fee EXCLUDED)
  platformFee             Int // cents — commission only (fee excluded)
  // Client booking fee (2.50 CHF/ticket, flag BOOKING_FEE). Platform's,
  // never part of wineryPayout. Charged amount = totalPrice + serviceFee.
  serviceFeeCents         Int                   @default(0)
  // Snapshot of the winery's cancellation policy at booking time — the
  // contractual terms the client accepted. Refunds use this, never the
  // winery's CURRENT policy. Null = legacy booking (fallback to winery).
  cancellationPolicy      CancellationPolicy?
  wineryPayout            Int // cents
  status                  BookingStatus         @default(PENDING_PAYMENT)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  expiresAt               DateTime? // For pending payment reservations
  accessTokenHash         String? // Hash of access token for verification (SEC-002: plaintext removed)
  confirmationSentAt      DateTime? // When client confirmation email was sent
  wineryNotifiedAt        DateTime? // When winery notification was sent
  reminder24hSentAt       DateTime? // When 24h reminder was sent
  reminder2hSentAt        DateTime? // When 2h reminder was sent
  followUpSentAt          DateTime? // When post-experience follow-up was sent
  // V3 (P-07): client locale captured at checkout — emails to the CLIENT use
  // this, never the winemaker's preferredLocale. FR default covers legacy rows.
  locale                  Locale                @default(FR)
  // V3 (P-07): hash of the tasting-recap token minted when the J+2 email is
  // sent (the confirmation accessToken plaintext is unrecoverable by then).
  recapTokenHash          String?
  tastingRecapSentAt      DateTime? // When the J+2 "coups de cœur" email was sent
  cancelledAt             DateTime? // When booking was cancelled
  cancellationReason      String?
  refundIssued            Boolean               @default(false)
  refundAmount            Int? // cents - amount refunded
  stripeRefundId          String? // Stripe refund ID for tracking
  refundError             String?
  checkedInAt             DateTime? // When client was checked in by winery (ENC-096)
  ageConfirmedAt          DateTime?
  ageConfirmedVersion     String?
  // V3 (P-02): optional link to a persisted occurrence. Capacity checks
  // keep using (experienceId, date, timeSlot) until P-05 switches over.
  occurrenceId            String?
  occurrence              ExperienceOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  wines            BookingWine[]
  wineOrderRequest WineOrderRequest?

  @@index([experienceId])
  @@index([wineryId])
  @@index([experienceId, date, timeSlot])
  @@index([experienceId, date, timeSlot, status])
  @@index([wineryId, date])
  @@index([status])
  // P-06 (L-207): dashboard/cron scans filter by status within a winery
  // or globally, always with a date bound.
  @@index([wineryId, status, date])
  @@index([status, date])
  // P-06 (L-207): my-bookings / nLPD export / anonymization query
  // visitorEmail with mode:'insensitive' (ILIKE) — only trigram serves it.
  @@index([visitorEmail(ops: raw("gin_trgm_ops"))], type: Gin, map: "bookings_visitor_email_trgm_idx")
  @@index([reference])
  @@index([accessTokenHash])
  @@index([recapTokenHash])
  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
  @@index([occurrenceId])
  @@map("bookings")
}

model StripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  status        String   @default("PROCESSING")
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@map("stripe_events")
}

model BlockedDate {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  reason       String?
  createdAt    DateTime   @default(now())

  @@unique([experienceId, date])
  @@index([experienceId])
  @@map("blocked_dates")
}

model NotificationPreferences {
  id String @id @default(cuid())

  wineryId String? @unique
  winery   Winery? @relation(fields: [wineryId], references: [id], onDelete: Cascade)

  // Winemaker preferences
  dailyDigest          Boolean @default(true) // Daily digest at 7am
  weeklySummary        Boolean @default(true) // Weekly summary on Mondays
  instantBookingAlerts Boolean @default(true) // Immediate booking notifications

  // Client preferences (for future use with user accounts)
  bookingReminders Boolean @default(true) // 24h and 2h reminders
  marketingEmails  Boolean @default(true) // Promotional/follow-up emails

  // Unsubscribe token for email links (SEC-004: added expiration)
  unsubscribeToken          String    @unique @default(cuid())
  unsubscribeTokenExpiresAt DateTime? // Token expires 30 days after creation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

model EmailLog {
  id           String   @id @default(cuid())
  type         String // reminder_24h, reminder_2h, daily_digest, follow_up, weekly_summary, tasting_recap, tasting_sheet_reminder, wine_order_request
  recipientId  String // User ID, Winery ID, or email address
  bookingId    String? // Optional booking reference
  status       String // sent, failed, skipped
  errorMessage String? // Error details if failed
  // V3 (P-07): per-winery open/click tracking. resendMessageId is the id
  // returned by resend.emails.send; the /api/webhooks/resend route matches
  // email.opened / email.clicked events back to this row (first-wins).
  resendMessageId String?   @unique
  wineryId        String?
  openedAt        DateTime?
  clickedAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([type, createdAt])
  @@index([recipientId])
  @@index([wineryId, type])
  @@map("email_logs")
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  status     String   @default("SUCCESS")
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("admin_actions")
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("coming-soon") // Where the subscription came from
  createdAt DateTime @default(now())

  @@map("newsletter_subscriptions")
}

// ============================================================
// V3 foundations (P-02) — no product surface reads these yet.
// Money invariants are enforced in SQL (CHECK + triggers) in the
// migration, not only here. See docs/plans/P-02-schema-v3.md.
// ============================================================

model Wine {
  id           String   @id @default(cuid())
  wineryId     String
  winery       Winery   @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  name         String
  grapeVariety String
  vintage      Int?
  price        Int // cents (CHF)
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookingWines      BookingWine[]
  orderRequestItems WineOrderRequestItem[]

  @@index([wineryId, available])
  @@map("wines")
}

// Tasting sheet (US-230): wines actually served during a booking.
model BookingWine {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  wineId    String
  wine      Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([bookingId, wineId])
  @@index([wineId])
  @@map("booking_wines")
}

// Client-scoped email opt-out (P-07, LCD compliance for the commercial
// "coups de cœur" recap). Keyed by lower-cased email — guests have no User
// row. Will back the /compte/profil preference in P-13.
model ClientEmailPreference {
  id               String   @id @default(cuid())
  email            String   @unique // always lower-cased at write time
  marketingOptOut  Boolean  @default(false)
  unsubscribeToken String   @unique @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("client_email_preferences")
}

// Wine order request from the J+2 tasting-recap email (US-230). Delivered to
// the winery by email at launch; this table is the future Shop 3.1 inbox.
// One request per booking (@unique) — the "1 tap" CTA is idempotent.
model WineOrderRequest {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  wineryId    String
  winery      Winery   @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  status      String   @default("NEW")
  // Snapshot of the client's contact details at request time.
  clientName  String
  clientEmail String
  clientPhone String?
  createdAt   DateTime @default(now())

  items WineOrderRequestItem[]

  @@index([wineryId, createdAt])
  @@map("wine_order_requests")
}

model WineOrderRequestItem {
  id             String           @id @default(cuid())
  orderRequestId String
  orderRequest   WineOrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  wineId         String
  wine           Wine             @relation(fields: [wineId], references: [id], onDelete: Restrict)
  // Snapshot: wine prices change, the request must reflect what was shown.
  wineName       String
  grapeVariety   String
  vintage        Int?
  priceAtRequest Int // cents
  quantity       Int

  @@index([orderRequestId])
  @@index([wineId])
  @@map("wine_order_request_items")
}

// Gift card (US-210). balance is materialized and guarded by a DB CHECK
// (>= 0); every movement MUST append a GiftCardTransaction in the same
// transaction. The ledger is append-only (DB trigger forbids UPDATE/DELETE).
model GiftCard {
  id                    String         @id @default(cuid())
  code                  String         @unique
  status                GiftCardStatus @default(ACTIVE)
  initialAmount         Int // cents
  balance               Int // cents — CHECK (balance >= 0) in migration
  purchaserEmail        String
  purchaserName         String?
  recipientEmail        String?
  recipientName         String?
  message               String?        @db.Text
  // Gift for a specific experience (optional); card survives its deletion.
  experienceId          String?
  experience            Experience?    @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  deliverAt             DateTime? // scheduled recipient delivery
  deliveredAt           DateTime?
  expiresAt             DateTime // 5-year legal validity
  stripePaymentIntentId String?
  locale                Locale         @default(FR)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  transactions GiftCardTransaction[]

  @@index([status, expiresAt])
  @@index([purchaserEmail])
  @@index([recipientEmail])
  @@index([experienceId])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id         String                  @id @default(cuid())
  giftCardId String
  giftCard   GiftCard                @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  type       GiftCardTransactionType
  // Signed delta in cents — enforced by a DB CHECK (ledger hardening
  // migration): PURCHASE/REFUND > 0, REDEMPTION < 0, ADJUSTMENT <> 0.
  amount     Int
  // Intentionally no FK to bookings: SET NULL is an UPDATE (blocked by
  // the append-only trigger) and RESTRICT would make bookings undeletable.
  bookingId  String?
  note       String?
  createdAt  DateTime                @default(now())

  @@index([giftCardId, createdAt])
  @@index([bookingId])
  @@map("gift_card_transactions")
}

// Sur-mesure request (US-240).
model Request {
  id          String        @id @default(cuid())
  reference   String        @unique // REQ-XXXXXXXX
  status      RequestStatus @default(PENDING)
  wineryId    String? // null = "laissez EnCave proposer"
  winery      Winery?       @relation(fields: [wineryId], references: [id], onDelete: SetNull)
  clientEmail String
  clientName  String
  clientPhone String?
  desiredDate DateTime?     @db.Date
  guestCount  Int
  budget      Int? // cents, indicative
  description String        @db.Text
  locale      Locale        @default(FR)
  closedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  offers RequestOffer[]

  @@index([wineryId, status])
  @@index([status, createdAt])
  @@index([clientEmail])
  @@map("requests")
}

model RequestOffer {
  id                      String             @id @default(cuid())
  requestId               String
  request                 Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status                  RequestOfferStatus @default(SENT)
  message                 String             @db.Text
  totalPrice              Int // cents
  expiresAt               DateTime
  reminderSentAt          DateTime? // single automatic reminder (spec)
  stripeCheckoutSessionId String?
  bookingId               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([requestId])
  @@index([status, expiresAt])
  @@map("request_offers")
}

// Persisted occurrence of a Slot experience (US-101). Uniqueness matches
// the legacy (experienceId, date, timeSlot) capacity key so existing
// bookings can be attached without rewriting the checkout (P-05).
// Provenance metadata ONLY — never a bookability discriminant (ADR-0002):
// the booking path treats RECURRING and PUNCTUAL identically.
enum OccurrenceSource {
  RECURRING
  PUNCTUAL
}

model ExperienceOccurrence {
  id               String           @id @default(cuid())
  experienceId     String
  experience       Experience       @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  date             DateTime         @db.Date
  startTime        String // "HH:mm" — same format as Booking.timeSlot
  status           OccurrenceStatus @default(OPEN)
  capacityOverride Int? // null = experience.maxCapacity — CHECK (>= 1) in migration
  source           OccurrenceSource @default(RECURRING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  bookings Booking[]

  @@unique([experienceId, date, startTime])
  @@index([experienceId, date])
  @@index([date, status])
  @@map("experience_occurrences")
}

// Collective events (US-250, light): participating wineries shown on the
// event page; the experience's own winery stays the single paid organizer.
model EventParticipant {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  wineryId     String
  winery       Winery     @relation(fields: [wineryId], references: [id], onDelete: Cascade)
  description  String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([experienceId, wineryId])
  @@index([wineryId])
  @@map("event_participants")
}

// Generic deferred-job table (Vercel Cron replaces Trigger.dev — stack
// decision). Used from P-03+ for gift-card delivery, request reminders
// and the J+2 tasting email.
model ScheduledJob {
  id        String             @id @default(cuid())
  type      String // e.g. GIFT_CARD_DELIVERY, REQUEST_OFFER_REMINDER, TASTING_RECAP
  runAt     DateTime
  status    ScheduledJobStatus @default(PENDING)
  payload   Json
  dedupeKey String?            @unique
  attempts  Int                @default(0)
  lastError String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status, runAt])
  @@index([type, status])
  @@map("scheduled_jobs")
}

// Money features ship behind kill-switches (delivery plan rule 3).
// Read through a 60s cache (src/lib/flags.ts); toggled from the admin
// (revalidateTag → immediate) or direct SQL (≤ 60s). Rows are created
// lazily — a missing row means the flag's REGISTRY default (OFF).
model FeatureFlag {
  key       String   @id // e.g. BOOKING_FEE — see FLAG_REGISTRY
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}
